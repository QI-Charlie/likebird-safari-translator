{
  "manifest_version": 2,
  "name": "LikeBird 飞译",
  "short_name": "LikeBird",
  "version": "1.2.0",
  "description": "在 Safari 里原位翻译网页，保留原站样式，默认译为简体中文。也支持划词翻译。",
  "author": "QI-Charlie",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "contextMenus",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_title": "LikeBird 飞译 · 翻译此页",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "19": "icons/icon-19.png",
      "32": "icons/icon-32.png",
      "38": "icons/icon-38.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-page": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "翻译或恢复当前页面"
    },
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "翻译当前选中的文字"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'"
}
