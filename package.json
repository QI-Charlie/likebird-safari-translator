{
  "name": "likebird-safari-translator",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "LikeBird 飞译 · Safari 整页翻译与划词翻译",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test",
    "app": "bash scripts/build-app.sh",
    "icons": "PYTHONPATH=.tools python3 scripts/make-icons.py",
    "pretest": "npm run build",
    "dmg": "npm run app && bash scripts/build-dmg.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15"
  },
  "dependencies": {
    "opencc-js": "1.4.2"
  }
}
